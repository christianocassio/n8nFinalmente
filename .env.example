# ==========================================
# Configurações do Assistente de Investimentos
# ==========================================

# URL do Webhook configurado no N8N (produção ou teste)
# Exemplo local: http://localhost:5678/webhook-test/clientes ou http://localhost:5678/webhook/clientes
N8N_WEBHOOK_URL=http://localhost:5678/webhook/clientes

# URL da página de raspagem de clientes (RPA)
CLIENTES_URL=https://digitalinnovationone.github.io/dio-lab-assistente-investimentos-rpa-n8n/

# URL do arquivo CSV com matriz de investimentos (ou caminho local)
INVESTIMENTOS_CSV_URL=https://digitalinnovationone.github.io/dio-lab-assistente-investimentos-rpa-n8n/data.csv

# Chaves de API para Modelos de IA (Opcional caso configure direto no N8N)
GEMINI_API_KEY=
OPENAI_API_KEY=
